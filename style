  :root{
    --bg: #08080a;
    --ink: #f4f4f2;
    --ink-dim: #9a9a9e;
    --ink-faint: #63636a;
    --line: rgba(255,255,255,0.09);
    --nav-h: 84px;

    --purple-1: #4b3fb0; --purple-2: #2a2270;
    --rust-1: #c9532b;   --rust-2: #7a2a12;
    --green-1: #1f4d3d;  --green-2: #0c211a;
    --slate-1: #3d4046;  --slate-2: #23252a;
    --blue-1: #2f4f8f;   --blue-2: #15243f;

    --nav-bg: rgba(8,8,10,0.5);
    --nav-bg-scrolled: rgba(8,8,10,0.78);
    --mobile-menu-bg: rgba(8,8,10,0.97);
    --tooltip-bg: #16171a;
    --backtotop-bg: rgba(18,18,22,0.7);
    --backtotop-bg-hover: rgba(40,40,46,0.9);
    --overlay-bg: rgba(4,4,6,0.72);
    --modal-from: #17181c;
    --modal-to: #0a0a0c;
    --pill-bg: rgba(255,255,255,0.08);
    --hover-bg: rgba(255,255,255,0.06);
    --hover-border: rgba(255,255,255,0.25);
    --aurora-a1: 0.42; --aurora-a2: 0.30; --aurora-a3: 0.28;
  }

  html[data-theme="light"]{
    --bg: #f3f3f5;
    --ink: #14141a;
    --ink-dim: #55565f;
    --ink-faint: #8a8b93;
    --line: rgba(0,0,0,0.10);

    --nav-bg: rgba(243,243,245,0.6);
    --nav-bg-scrolled: rgba(243,243,245,0.85);
    --mobile-menu-bg: rgba(243,243,245,0.97);
    --tooltip-bg: #ffffff;
    --backtotop-bg: rgba(255,255,255,0.75);
    --backtotop-bg-hover: rgba(255,255,255,0.95);
    --overlay-bg: rgba(20,20,26,0.45);
    --modal-from: #ffffff;
    --modal-to: #eeeef1;
    --pill-bg: rgba(0,0,0,0.05);
    --hover-bg: rgba(0,0,0,0.05);
    --hover-border: rgba(0,0,0,0.22);
    --aurora-a1: 0.22; --aurora-a2: 0.16; --aurora-a3: 0.15;
    color-scheme: light;
  }

  html{ color-scheme: dark; }
  *{ margin:0; padding:0; box-sizing:border-box; }

  html{ scroll-behavior: smooth; scroll-snap-type: y proximity; overscroll-behavior-y: none; }

  body{
    background: var(--bg);
    color: var(--ink);
    font-family: -apple-system, BlinkMacSystemFont, "SF Pro Display", "SF Pro Text",
      "Helvetica Neue", Helvetica, Arial, sans-serif;
    -webkit-font-smoothing: antialiased;
    overflow-x: hidden;
    overscroll-behavior-y: none;
    transition: background .3s ease, color .3s ease;
  }

  a{ color:inherit; text-decoration:none; }
  button{ font-family:inherit; }

  :focus-visible{ outline: 2px solid #7c8cff; outline-offset: 3px; }

  @media (prefers-reduced-motion: reduce){
    *{ animation: none !important; transition: none !important; }
    html{ scroll-behavior:auto; }
  }

  /* reveal-on-scroll */
  .reveal{ opacity:0; transform: translateY(22px); transition: opacity .8s cubic-bezier(.16,.8,.4,1), transform .8s cubic-bezier(.16,.8,.4,1); }
  .reveal.is-visible{ opacity:1; transform:none; }

  /* ---------- fixed nav ---------- */
  nav{
    position: fixed; top:0; left:0; right:0; height: var(--nav-h);
    display:flex; align-items:center; justify-content:space-between;
    padding: 0 56px 0 48px; z-index: 100;
    background: var(--nav-bg);
    backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px);
    border-bottom: 1px solid transparent;
    transition: border-color .3s ease, background .3s ease;
  }
  nav.scrolled{ border-bottom-color: var(--line); background: var(--nav-bg-scrolled); }

  .logo{ font-size: 19px; font-weight: 600; letter-spacing: -0.01em; }

  .nav-links{ display:flex; gap:40px; list-style:none; }
  .nav-links li{
    position:relative; font-size:14px; color: var(--ink-dim); cursor:pointer;
    padding: 30px 0 26px; transition: color .2s ease; background:none; border:none;
  }
  .nav-links li:hover{ color: var(--ink); }
  .nav-links li.active{ color: var(--ink); }
  .nav-links li.active::after{
    content:''; position:absolute; left:50%; bottom:22px; width:4px; height:4px;
    border-radius:50%; background: var(--ink); transform: translateX(-50%);
  }

  .nav-right{ display:flex; align-items:center; gap:14px; }
  .nav-cta-wrap{ position:relative; }

  .theme-toggle{
    width: 62px; height: 32px; border: 1px solid var(--line); border-radius: 20px;
    display: flex; align-items: center; justify-content: space-between;
    padding: 0 10px; background: transparent; cursor: pointer; flex-shrink: 0;
    transition: background .2s ease, border-color .2s ease;
  }
  .theme-toggle:hover{ background: var(--hover-bg); border-color: var(--hover-border); }
  .theme-toggle svg { width: 14px; height: 14px; transition: opacity .2s ease, color .2s ease; color: var(--ink-dim); }
  .theme-toggle .icon-sun { opacity: 0.3; }
  .theme-toggle .icon-moon { opacity: 1; color: var(--ink); }
  html[data-theme="light"] .theme-toggle .icon-sun { opacity: 1; color: var(--ink); }
  html[data-theme="light"] .theme-toggle .icon-moon { opacity: 0.3; color: var(--ink-dim); }

  .nav-burger{
    display:none; width:36px; height:36px; border:1px solid var(--line); border-radius:50%;
    background:transparent; cursor:pointer; flex-direction:column; align-items:center; justify-content:center; gap:4px;
    flex-shrink:0; z-index: 210;
  }
  .nav-burger span{ width:15px; height:1.5px; background: var(--ink); border-radius:2px; transition: transform .25s ease, opacity .25s ease; }
  .nav-burger.open span:nth-child(1){ transform: translateY(5.5px) rotate(45deg); }
  .nav-burger.open span:nth-child(2){ opacity:0; }
  .nav-burger.open span:nth-child(3){ transform: translateY(-5.5px) rotate(-45deg); }

  .mobile-menu{
    position:fixed; inset:0; z-index:200; background: var(--mobile-menu-bg);
    backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px);
    display:flex; align-items:center; justify-content:center;
    opacity:0; pointer-events:none; transform: translateY(-10px);
    transition: opacity .25s ease, transform .25s ease;
  }
  .mobile-menu.open{ opacity:1; pointer-events:auto; transform:none; }
  .mobile-menu ul{ list-style:none; text-align:center; }
  .mobile-menu li{ font-size: 26px; font-weight:600; letter-spacing:-0.02em; padding: 18px 0; color: var(--ink-dim); cursor:pointer; transition: color .2s ease; }
  .mobile-menu li:hover, .mobile-menu li.active{ color: var(--ink); }
  
  .nav-cta{
    width:36px; height:36px; border:1px solid var(--line); border-radius:50%;
    display:flex; align-items:center; justify-content:center; color: var(--ink);
    transition: background .2s ease, border-color .2s ease; cursor:pointer; flex-shrink:0;
  }
  .nav-cta:hover{ background: var(--hover-bg); border-color: var(--hover-border); }

  .nav-tooltip{
    position:absolute; top: 48px; right:0; z-index: 150; max-width: 220px;
    background: var(--tooltip-bg); border:1px solid var(--line); color: var(--ink); font-size:13px;
    line-height:1.4; padding:12px 16px; border-radius:14px; white-space:normal;
    opacity:0; transform: translateY(-6px); pointer-events:none;
    transition: opacity .2s ease, transform .2s ease;
    box-shadow: 0 20px 40px -12px rgba(0,0,0,0.6);
  }
  .nav-tooltip.show{ opacity:1; transform:none; pointer-events:auto; }
  .nav-tooltip::before{
    content:''; position:absolute; top:-6px; right:14px; width:12px; height:12px; background: var(--tooltip-bg);
    border-left:1px solid var(--line); border-top:1px solid var(--line); transform: rotate(45deg);
  }

  .back-to-top{
    position: fixed; right: 28px; bottom: 28px; width:50px; height:50px; border-radius:50%;
    background: var(--backtotop-bg); border:1px solid var(--line); backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px); color: var(--ink); display:flex; align-items:center;
    justify-content:center; cursor:pointer; z-index: 90; opacity:0; transform: translateY(12px);
    pointer-events:none; transition: opacity .3s ease, transform .3s ease, background .2s ease;
  }
  .back-to-top.show{ opacity:1; transform:none; pointer-events:auto; }
  .back-to-top:hover{ background: var(--backtotop-bg-hover); }

  .screen{ position:relative; height:100vh; scroll-snap-align: start; scroll-snap-stop: always; display:flex; flex-direction:column; overflow-y:auto; scrollbar-width:none; -ms-overflow-style:none; }
  .screen::-webkit-scrollbar{ display:none; }

  /* ================= SCREEN 1 — HERO ================= */
  #hero{ align-items:center; justify-content:center; padding-top: var(--nav-h); text-align:center; --mx:0px; --my:0px; }
  #hero::before{
    content:''; position:absolute; inset:-15%; z-index:0; pointer-events:none;
    background:
      radial-gradient(42% 38% at calc(30% + var(--mx)) calc(35% + var(--my)), rgba(255,0,200,var(--aurora-a1)), transparent 70%),
      radial-gradient(38% 34% at calc(72% - var(--mx)) calc(60% - var(--my)), rgba(0,255,255,var(--aurora-a2)), transparent 70%),
      radial-gradient(34% 32% at calc(58% + var(--my)) calc(18% + var(--mx)), rgba(120,50,255,var(--aurora-a3)), transparent 70%);
    filter: blur(64px);
    animation: auroraMove 14s ease-in-out infinite alternate;
  }
  @keyframes auroraMove{
    0%{ transform: translate3d(0,0,0) scale(1); }
    50%{ transform: translate3d(3%, -4%, 0) scale(1.12); }
    100%{ transform: translate3d(-4%, 3%, 0) scale(1); }
  }
  .hero-inner{ position:relative; z-index:2; max-width: 760px; padding: 0 24px; }
  .eyebrow{
    display:inline-flex; align-items:center; gap:8px; font-size: 13px; color: var(--ink-dim);
    border: 1px solid var(--line); border-radius: 20px; padding: 6px 14px; margin-bottom: 28px;
  }
  .eyebrow span{ width:6px; height:6px; border-radius:50%; background:#5eff9a; display:inline-block; }
  #hero h1{ position:relative; z-index:2; font-size: clamp(48px, 7.2vw, 92px); font-weight: 600; letter-spacing: -0.035em; line-height: 1.02; }
  .hero-quote{
    position:relative; z-index:2; margin: 26px auto 0; max-width: 680px;
    font-family: 'Space Mono', 'Courier New', ui-monospace, monospace;
  }
  .hero-quote p{ margin:0; color: var(--ink-dim); line-height: 1.75; }
  .hero-quote .hq-question{
    font-size: clamp(14px, 1.8vw, 18px); opacity:.8; letter-spacing:0.02em;
  }
  .hero-quote .hq-answer{
    margin-top: 14px; font-size: clamp(14px, 1.8vw, 18px); letter-spacing:0.02em; color: var(--ink);
  }
  .hero-quote .hq-cursor{
    display:inline-block; margin-left:2px; color: var(--ink); animation: hqBlink 1s steps(1,end) infinite;
  }
  @keyframes hqBlink{ 50%{ opacity:0; } }

  .scroll-cue{ position:absolute; left:50%; bottom: 44px; transform: translateX(-50%); z-index: 3; }
  .scroll-cue button{
    width: 46px; height:46px; border-radius:50%; border: 1px solid var(--line); background: transparent;
    color: var(--ink); display:flex; align-items:center; justify-content:center; cursor:pointer;
    transition: background .2s ease; animation: bob 2.4s ease-in-out infinite;
  }
  .scroll-cue button:hover{ background: var(--hover-bg); }
  @keyframes bob{ 0%,100%{ transform: translateY(0); } 50%{ transform: translateY(6px); } }

  /* shared section header row */
  .section-top{
    display:flex; justify-content:space-between; align-items:flex-start;
    padding: 0 56px 0 48px; gap: 40px; flex-shrink:0;
  }
  .section-copy h2{ font-size: clamp(34px, 4.6vw, 54px); font-weight: 600; letter-spacing: -0.03em; line-height: 1.05; max-width: 640px; }
  .section-copy p{ margin-top: 14px; font-size: 16px; color: var(--ink-dim); line-height: 1.55; max-width: 380px; }
  .section-note{ text-align:right; font-size: 15px; color: var(--ink-dim); line-height: 1.6; max-width: 300px; padding-top: 10px; flex-shrink:0; }

  /* ================= SCREEN 2 — EXPERIENCE (fan) ================= */
  #experience{ padding-top: calc(var(--nav-h) + 70px); justify-content:flex-start; }
  .stage{ position:relative; flex:1; display:flex; align-items:center; justify-content:center; margin-top: 40px; padding: 0 20px 60px; width: 100%; }
  .cards{ position:relative; display:flex; align-items:center; justify-content:center; width:100%; max-width: 1200px; }

  .card{
    --accent-bright:#c9c9d2; --accent-soft: rgba(255,255,255,0.04); --accent-line: rgba(255,255,255,0.15); --accent-glow: rgba(255,255,255,0.04);
    position:relative; width: 270px; min-height: 420px; border-radius: 22px;
    background: linear-gradient(180deg, #121216, #030304 88%);
    border: 1px solid var(--accent-line); padding: 26px 22px; display:flex; flex-direction:column;
    justify-content:space-between; overflow:hidden; flex-shrink:0; cursor: pointer;
    box-shadow: 0 0 0 1px var(--accent-soft), 0 0 12px var(--accent-glow), 0 20px 40px -20px rgba(0,0,0,0.8);
    transition: transform .4s cubic-bezier(.2,.8,.2,1), box-shadow .4s ease;
  }
  .cards .card:not(:first-child){ margin-left: -50px; }
  
  .card:not(.selected):hover{ transform: translateY(-14px) !important; z-index: 20; }
  .card.selected{ box-shadow: 0 0 0 1px var(--accent-line), 0 0 18px var(--accent-glow), 0 30px 60px -20px rgba(0,0,0,0.85) !important; z-index: 25 !important; }

  .card .period{ font-size: 11px; color: var(--accent-bright); background: var(--accent-soft); border: 1px solid var(--accent-line); display:inline-block; padding: 5px 10px; border-radius: 20px; align-self:flex-start; white-space:nowrap; }
  .card .role{ font-size: 13px; color: var(--accent-bright); margin-top: 6px; opacity:.85; }
  .card .title{ font-size: 20px; font-weight: 800; letter-spacing: -0.01em; margin-top: 8px; line-height:1.15; font-style: italic; text-transform: uppercase; color:#f5f5f8; }
  .card .brand{ font-weight: 700; font-size: 14px; letter-spacing: 0.02em; color: var(--accent-bright); }

  .card-footer{ position:relative; z-index:2; display:flex; align-items:center; justify-content:space-between; gap:8px; margin-top: 20px; }
  .details-btn{
    display:none; align-items:center; gap:4px; font-size: 11px; font-weight:600; white-space:nowrap;
    padding: 7px 12px; border-radius: 20px; background: var(--accent-soft);
    border: 1px solid var(--accent-line); color:#fff; cursor:pointer;
    transition: background .2s ease, transform .2s ease; opacity:0;
  }
  .card.selected .details-btn{ display:inline-flex; opacity:1; animation: btnIn .3s ease; }
  .details-btn:hover{ background: var(--accent-line); transform: translateY(-1px); }
  @keyframes btnIn{ from{ opacity:0; transform: translateY(4px); } to{ opacity:1; transform:none; } }

  /* Очень нежная, мягкая палитра акцентов для карточек */
  .card-1{ --accent-bright:#ffb3c6; --accent-soft: rgba(255,179,198,0.05); --accent-line: rgba(255,179,198,0.18); --accent-glow: rgba(255,179,198,0.06); transform: rotate(-12deg) translateY(32px); z-index:1; }
  .card-2{ --accent-bright:#c3b8ff; --accent-soft: rgba(139,120,255,0.05); --accent-line: rgba(139,120,255,0.18); --accent-glow: rgba(139,120,255,0.06); transform: rotate(-7deg) translateY(10px); z-index:2; }
  .card-3{ --accent-bright:#ffb08c; --accent-soft: rgba(201,83,43,0.05); --accent-line: rgba(201,83,43,0.18); --accent-glow: rgba(201,83,43,0.06); transform: rotate(-2deg) translateY(-4px); z-index:3; }
  .card-4{ --accent-bright:#8fffb8; --accent-soft: rgba(94,255,154,0.05); --accent-line: rgba(94,255,154,0.18); --accent-glow: rgba(94,255,154,0.06); transform: rotate(2deg) translateY(-4px); z-index:4; }
  .card-5{ --accent-bright:#9dc4ff; --accent-soft: rgba(90,150,255,0.05); --accent-line: rgba(90,150,255,0.18); --accent-glow: rgba(90,150,255,0.06); transform: rotate(7deg) translateY(10px); z-index:5; }
  .card-5::before{ content:''; position:absolute; inset:0; z-index:1; pointer-events:none; background: linear-gradient(180deg, rgba(3,4,8,0.7) 0%, rgba(3,4,8,0.55) 42%, rgba(3,4,8,0.2) 62%, rgba(3,4,8,0.55) 100%); }
  .card-6{ --accent-bright:#d4d6de; --accent-soft: rgba(200,205,220,0.04); --accent-line: rgba(200,205,220,0.15); --accent-glow: rgba(200,205,220,0.05); transform: rotate(12deg) translateY(32px); z-index:6; }

  .card-1.selected{ transform: rotate(-12deg) translateY(-10px) scale(1.05) !important; }
  .card-2.selected{ transform: rotate(-7deg) translateY(-16px) scale(1.05) !important; }
  .card-3.selected{ transform: rotate(-2deg) translateY(-30px) scale(1.05) !important; }
  .card-4.selected{ transform: rotate(2deg) translateY(-30px) scale(1.05) !important; }
  .card-5.selected{ transform: rotate(7deg) translateY(-16px) scale(1.05) !important; }
  .card-6.selected{ transform: rotate(12deg) translateY(-10px) scale(1.05) !important; }

  .card-1 .art{ position:absolute; right:-10%; top:-10%; width:70%; height:50%; background: radial-gradient(circle, var(--accent-glow), transparent 70%); border-radius:50%; }
  .card-2 .art{ position:absolute; inset:0; background: radial-gradient(circle at 30% 25%, var(--accent-glow), transparent 55%); }
  .card-3 .art{ position:absolute; right:-6%; bottom:-4%; width:78%; height:46%; background: linear-gradient(135deg, var(--accent-glow), transparent 60%); clip-path: polygon(20% 100%, 0% 55%, 30% 20%, 55% 0%, 70% 30%, 100% 15%, 100% 100%); }
  .card-4 .art{ position:absolute; inset:0; background: radial-gradient(circle at 75% 12%, var(--accent-glow), transparent 55%), radial-gradient(circle at 10% 90%, rgba(94,255,154,0.06), transparent 50%); }
  .card-5 .art{ position:absolute; left:-25%; right:-15%; bottom:-18%; top:56%; border-radius: 50% 50% 0 0 / 60% 60% 0 0; background: radial-gradient(circle at 35% 25%, #c3d3ea 0%, #8398b8 18%, #34455f 42%, #0b1220 70%); box-shadow: inset -20px -10px 60px rgba(0,0,0,0.55); opacity:0.6; }
  .card-5 .art::after{ content:''; position:absolute; left:10%; top:8%; width:34%; height:22%; background: rgba(255,255,255,0.2); border-radius: 50%; filter: blur(10px); }
  .card-6 .art{ position:absolute; right:-18%; bottom:-14%; width:70%; height:52%; border-radius: 50%; background: radial-gradient(circle at 60% 35%, var(--accent-glow), transparent 60%); border: 10px solid rgba(255,255,255,0.05); }

  .card-body{ position:relative; z-index:2; flex-grow: 1; display:flex; flex-direction:column; }
  .card-list{ margin-top: 16px; list-style:none; font-size: 12.5px; color: rgba(255,255,255,0.75); line-height: 1.6; flex-grow:1; }
  .card-list li{ position:relative; padding-left: 14px; margin-bottom: 6px;}
  .card-list li::before{ content:'✓'; position:absolute; left:0; color: var(--accent-bright); }

  /* ================= SCREEN 3 — PORTFOLIO (carousel) ================= */
  #portfolio{ padding-top: calc(var(--nav-h) + 32px); justify-content:flex-start; }
  .carousel-wrap{ position:relative; flex: 1 1 auto; min-height:0; display:flex; align-items:stretch; gap: 14px; padding: 0 48px; }
  .flat-grid{
    flex:1; min-width:0; display:flex; gap: 18px; overflow-x:auto; scroll-snap-type:x mandatory;
    -webkit-overflow-scrolling:touch; padding: 20px 4px 24px; scrollbar-width:none;
    cursor: grab;
  }
  .flat-grid.dragging{ cursor: grabbing; scroll-snap-type: none; user-select:none; }
  .flat-grid.dragging .flat-card{ pointer-events:none; }
  .flat-grid::-webkit-scrollbar{ display:none; }
  .flat-card{
    position:relative; flex: 0 0 auto; width: 290px; height:100%; scroll-snap-align:center;
    border-radius: 20px; border: 1px solid var(--line);
    padding: 22px; display:flex; flex-direction:column; justify-content:flex-end;
    overflow:hidden; min-height: 240px; max-height: 460px; box-shadow: 0 24px 50px -24px rgba(0,0,0,0.6);
    transition: transform .35s ease; background-size: cover; background-position: center;
  }
  .flat-card:hover{ transform: translateY(-8px); }
  .flat-card::before{
    content:''; position:absolute; inset:0; z-index:1;
    background: linear-gradient(180deg, rgba(6,6,8,0.05) 35%, rgba(6,6,8,0.92) 100%);
  }
  .flat-card h3{ font-size: 18px; font-weight: 600; letter-spacing: -0.01em; line-height:1.25; position:relative; z-index:2; color:#fff; }
  .flat-card .cat{ font-size: 12.5px; color: rgba(255,255,255,0.65); margin-top: 6px; position:relative; z-index:2; }
  .flat-icon{
    width: 32px; height: 32px; border-radius: 50%; background: rgba(255,255,255,0.16);
    display:flex; align-items:center; justify-content:center; position:absolute; top:20px; right:20px; z-index:2;
    color:#fff; line-height:0;
  }
  .flat-icon svg{ display:block; }
  .carousel-arrow{
    flex-shrink:0; width:44px; height:44px; border-radius:50%; border:1px solid var(--line);
    background: var(--backtotop-bg); backdrop-filter: blur(10px); color: var(--ink); font-size:18px;
    display:flex; align-items:center; justify-content:center; cursor:pointer; z-index:5;
    transition: background .2s ease; align-self:center;
  }
  .carousel-arrow:hover{ background: var(--backtotop-bg-hover); }
  .portfolio-more{
    display:inline-flex; align-items:center; gap:8px; margin: 4px 48px 14px; font-size: 14px;
    color: var(--ink-dim); border: 1px solid var(--line); border-radius: 30px; padding: 9px 18px;
    transition: background .2s ease, color .2s ease, border-color .2s ease; width: fit-content; flex-shrink:0;
  }
  .portfolio-more:hover{ background: var(--hover-bg); color: var(--ink); border-color: var(--hover-border); }

  /* ---- Видео-работы: спойлер (скрыт до загрузки материалов) ---- */
  .video-spoiler{
    position:relative; margin: 0 48px 20px; border-radius: 22px; overflow: hidden; flex-shrink:0;
    background: linear-gradient(135deg, rgba(139,120,255,0.10), rgba(90,150,255,0.05) 45%, transparent 75%);
    border: 1px solid rgba(139,120,255,0.22);
    box-shadow: 0 18px 40px -26px rgba(90,80,220,0.55);
    transition: border-color .25s ease, box-shadow .25s ease;
  }
  .video-spoiler:hover{ border-color: rgba(139,120,255,0.4); box-shadow: 0 22px 50px -24px rgba(90,80,220,0.7); }
  .video-spoiler-toggle{
    width:100%; display:flex; align-items:center; gap:16px;
    padding: 20px 22px; background: transparent; border:none; cursor:pointer; text-align:left;
  }
  .video-spoiler-icon{
    flex-shrink:0; width:42px; height:42px; border-radius:50%;
    background: linear-gradient(135deg, #8b78ff, #5a96ff);
    display:flex; align-items:center; justify-content:center;
    box-shadow: 0 8px 18px -6px rgba(139,120,255,0.6);
  }
  .video-spoiler-icon svg{ width:16px; height:16px; fill:#fff; margin-left:2px; }
  .video-spoiler-text{ flex:1; min-width:0; }
  .video-spoiler-text .vs-title{ display:flex; align-items:center; gap:10px; font-size: 15px; font-weight:700; color: var(--ink); letter-spacing:-0.01em; }
  .video-spoiler-badge{
    font-size:10.5px; font-weight:700; letter-spacing:0.03em; text-transform:uppercase;
    color:#c3b8ff; background: rgba(139,120,255,0.14); border:1px solid rgba(139,120,255,0.3);
    padding:3px 9px; border-radius:20px;
  }
  .video-spoiler-toggle .vs-sub{ display:block; margin-top:4px; font-size:12.5px; font-weight:400; color: var(--ink-dim); }
  .video-spoiler-arrow{
    flex-shrink:0; width:30px; height:30px; border-radius:50%; border:1px solid var(--line);
    display:flex; align-items:center; justify-content:center; color: var(--ink-dim);
    transition: transform .3s ease, background .2s ease;
  }
  .video-spoiler-toggle:hover .video-spoiler-arrow{ background: var(--hover-bg); color: var(--ink); }
  .video-grid{ display:grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap:16px; margin-top: 20px; }
  .video-card{
    border-radius:16px; overflow:hidden; border:1px solid var(--line); background: rgba(255,255,255,0.03);
    display:block; transition: border-color .2s ease, transform .2s ease;
  }
  a.video-card:hover{ border-color: var(--hover-border); transform: translateY(-2px); }
  .video-card video, .video-card iframe{
    display:block; width:100%; aspect-ratio: var(--vratio, 9/16); object-fit:cover; background:#000; border:0;
  }
  .video-card-thumb{
    position:relative; width:100%; aspect-ratio: var(--vratio, 9/16); background-size:cover; background-position:center;
    background-color:#141418;
    background-image: linear-gradient(135deg, rgba(139,120,255,0.28), rgba(90,150,255,0.14));
    display:flex; align-items:center; justify-content:center;
  }
  .video-card-play{
    width:46px; height:46px; border-radius:50%; background: rgba(8,8,10,0.55); border:1px solid rgba(255,255,255,0.25);
    display:flex; align-items:center; justify-content:center; color:#fff; font-size:18px; backdrop-filter: blur(4px);
  }
  .video-card-info{ padding: 10px 14px 14px; }
  .video-card-info h4{ font-size:13.5px; font-weight:600; }
  .video-card-info .cat{ font-size:11.5px; color: var(--ink-dim); margin-top:3px; display:block; }
  .video-empty-note{ font-size:13.5px; color: var(--ink-dim); text-align:center; padding: 18px 4px; grid-column: 1/-1; }

  /* ================= SCREEN 4 — ABOUT ================= */
  #about{ align-items:center; padding-top: var(--nav-h); }
  .about-wrap{
    flex:1; width:100%; max-width: 1180px; margin: 0 auto; padding: 0 48px;
    display:grid; grid-template-columns: 1fr 1fr; gap: 60px; align-items:center;
  }
  .about-photo-grid{
    position:relative; aspect-ratio: 1/1; border-radius: 26px; overflow:hidden;
    border: 1px solid var(--line);
    background: linear-gradient(160deg, #2a2270, #14122f 80%);
  }
  .about-photo-grid::before{ content:''; position:absolute; inset:0; background: radial-gradient(circle at 30% 20%, rgba(255,255,255,0.16), transparent 60%); pointer-events:none; z-index:2; }
  .about-photo-grid img{ width:100%; height:100%; object-fit:cover; position:relative; z-index:1; display:block; }

  .about-copy .eyebrow{ margin-bottom: 22px; }
  .about-copy h2{ font-size: clamp(32px, 4.2vw, 48px); font-weight: 600; letter-spacing: -0.03em; line-height: 1.1; }
  .about-copy p{ margin-top: 18px; font-size: 16.5px; color: var(--ink-dim); line-height: 1.65; max-width: 480px; }

  .about-facts{ display:flex; gap: 34px; margin-top: 32px; }
  .about-facts div b{ display:block; font-size: 26px; font-weight: 700; }
  .about-facts div span{ font-size: 13px; color: var(--ink-dim); }

  /* ================= SCREEN 5 — CONTACTS ================= */
  #contacts{ align-items:center; justify-content:center; text-align:center; padding-top: var(--nav-h); }
  #contacts::before{
    content:''; position:absolute; inset:-15%; z-index:0; pointer-events:none;
    background:
      radial-gradient(36% 32% at 35% 60%, rgba(150,130,255,0.16), transparent 70%),
      radial-gradient(32% 28% at 68% 40%, rgba(255,130,190,0.10), transparent 70%),
      radial-gradient(28% 26% at 55% 75%, rgba(110,230,210,0.10), transparent 70%);
    filter: blur(80px);
    animation: auroraMove 26s ease-in-out infinite alternate;
  }
  .contacts-inner{ position:relative; z-index:2; max-width: 640px; padding: 0 24px; }
  #contacts h2{ font-size: clamp(38px, 5.6vw, 64px); font-weight: 600; letter-spacing: -0.03em; line-height: 1.05; }
  #contacts p{ margin: 18px auto 0; font-size: 17px; color: var(--ink-dim); line-height: 1.6; max-width: 420px; }
  .contact-email{
    display:inline-block; margin-top: 30px; font-size: 20px; font-weight: 600;
    border-bottom: 1px solid var(--line); padding-bottom: 6px; transition: border-color .2s ease, color .2s ease;
  }
  .contact-email:hover{ border-color: var(--ink); color: var(--ink); }

  .social-row{ display:flex; gap: 14px; justify-content:center; margin-top: 40px; flex-wrap:wrap; }
  .social-row a{
    display:flex; align-items:center; gap:8px; font-size: 14px; color: var(--ink-dim);
    border: 1px solid var(--line); border-radius: 30px; padding: 10px 20px;
    transition: background .2s ease, color .2s ease, border-color .2s ease;
  }
  .social-row a:hover{ background: var(--hover-bg); color: var(--ink); border-color: var(--hover-border); }

  footer{ position:absolute; left:0; right:0; bottom:18px; z-index:2; text-align:center; font-size: 12.5px; color: var(--ink-faint); }

  /* ================= SECRET CUE (under About) ================= */
  .secret-cue{ position:absolute; left:50%; bottom: 18px; transform:translateX(-50%); z-index:3; }
  .secret-cue button{
    width:40px; height:40px; border-radius:50%; border:1px dashed var(--ink-faint); background:transparent;
    color: var(--ink-faint); display:flex; align-items:center; justify-content:center; cursor:pointer;
    opacity:.5; transition: opacity .3s ease, transform .3s ease, color .3s ease, border-color .3s ease;
    animation: bob 3s ease-in-out infinite;
  }
  .secret-cue button:hover{ opacity:1; color:#ff2f6e; border-color:#ff2f6e; border-style:solid; transform: scale(1.08); }
  .secret-tooltip{
    position:absolute; left:50%; bottom: 56px; width:220px;
    background: var(--tooltip-bg); border:1px solid var(--line); color: var(--ink); font-size:13px;
    line-height:1.4; padding:12px 16px; border-radius:14px; text-align:center;
    opacity:0; transform: translateX(-50%) translateY(6px); pointer-events:none;
    transition: opacity .2s ease, transform .2s ease;
    box-shadow: 0 20px 40px -12px rgba(0,0,0,0.6);
  }
  .secret-tooltip.show{ opacity:1; transform: translateX(-50%) translateY(0); }
  .secret-tooltip::after{
    content:''; position:absolute; left:50%; bottom:-6px; width:12px; height:12px; background: var(--tooltip-bg);
    border-right:1px solid var(--line); border-bottom:1px solid var(--line); transform: translateX(-50%) rotate(45deg);
  }

  /* ================= HIDDEN SCREEN — VIBES (easter egg overlay) ================= */
  body.vibes-open{ overflow:hidden; }
  .vibes-overlay{
    position:fixed; inset:0; z-index: 400; display:flex; align-items:center; justify-content:center;
    overflow-y:auto; -webkit-overflow-scrolling:touch; text-align:center;
    background: linear-gradient(120deg, #ff5fae, #ff9d4d 28%, #ffe14d 52%, #6ee7ff 76%, #b98bff 100%);
    background-size: 300% 300%; animation: vibesGradient 16s ease-in-out infinite;
    opacity:0; pointer-events:none; transform: scale(0.98);
    transition: opacity .35s ease, transform .35s ease; color:#14141a;
  }
  .vibes-overlay.open{ opacity:1; pointer-events:auto; transform:none; }
  @keyframes vibesGradient{
    0%{ background-position: 0% 50%; }
    50%{ background-position: 100% 50%; }
    100%{ background-position: 0% 50%; }
  }
  .vibes-marquee{ position:absolute; left:-4%; right:-4%; z-index:2; overflow:hidden; white-space:nowrap; background: #14141a; padding: 9px 0; }
  .vibes-marquee.top{ top: 26px; transform: rotate(-1.4deg); }
  .vibes-marquee.bottom{ bottom: 26px; transform: rotate(1.4deg); }
  .marquee-track{ display:inline-flex; width:max-content; animation: marqueeScroll 24s linear infinite; }
  .marquee-track.reverse{ animation-direction: reverse; }
  .marquee-track span{ display:inline-block; padding-right: 26px; font-size:13px; font-weight:800; letter-spacing:0.05em; text-transform:uppercase; color:#fff; }
  @keyframes marqueeScroll{ from{ transform:translateX(0); } to{ transform:translateX(-50%); } }

  .vibes-inner{ position:relative; z-index:3; max-width: 720px; padding: 100px 24px 90px; }
  .vibes-badge{
    display:inline-flex; align-items:center; gap:8px; font-size:13px; font-weight:700;
    background:#14141a; color:#fff; border-radius:30px; padding:8px 16px; margin-bottom: 26px;
    transform: rotate(-2deg);
  }
  .vibes-title{ display:flex; flex-direction:column; gap:2px; font-size: clamp(38px, 8.6vw, 92px); font-weight:900; line-height:0.96; letter-spacing:-0.02em; text-transform:uppercase; }
  .vibes-title span{ -webkit-text-stroke: 2px #14141a; text-shadow: 4px 4px 0 #14141a; }
  .vibes-title span:nth-child(1){ color:#ff2f6e; transform: rotate(-2deg); }
  .vibes-title span:nth-child(2){ color:#ffd23f; transform: rotate(1.4deg); }
  .vibes-title span:nth-child(3){ color:#3fd6ff; transform: rotate(-1deg); }
  .vibes-sub{ margin: 24px auto 0; max-width: 460px; font-size:16px; font-weight:600; }

  .sticker-grid{ display:flex; flex-wrap:wrap; gap:14px; justify-content:center; margin-top: 42px; }
  .sticker{
    background:#14141a; color:#fff; font-size:13px; font-weight:800; letter-spacing:0.01em;
    padding: 12px 18px; border-radius: 40px; border: 2px solid #14141a;
    box-shadow: 4px 4px 0 rgba(20,20,26,0.45);
    transition: transform .25s ease, box-shadow .25s ease;
  }
  .sticker:hover{ transform: translateY(-4px) rotate(-2deg) scale(1.05); box-shadow: 6px 6px 0 rgba(20,20,26,0.5); }
  .sticker.s1{ transform: rotate(-3deg); } .sticker.s2{ transform: rotate(2deg); }
  .sticker.s3{ transform: rotate(-1.5deg); } .sticker.s4{ transform: rotate(3deg); }
  .sticker.s5{ transform: rotate(-2.5deg); } .sticker.s6{ transform: rotate(1.5deg); }

  .vibes-cta{
    display:inline-block; margin-top: 42px; background:#14141a; color:#fff; font-weight:800;
    font-size:15px; padding: 14px 28px; border-radius: 40px; border:2px solid #14141a;
    box-shadow: 5px 5px 0 rgba(20,20,26,0.4); transition: transform .2s ease, box-shadow .2s ease;
  }
  .vibes-cta:hover{ transform: translateY(-3px); box-shadow: 7px 7px 0 rgba(20,20,26,0.45); }

  .vibes-close{
    position:absolute; top: 78px; right: 28px; z-index:5;
    width:42px; height:42px; border-radius:50%; border:2px solid #14141a; background:#fff; color:#14141a;
    font-size:18px; line-height:1; display:flex; align-items:center; justify-content:center; cursor:pointer;
    box-shadow: 3px 3px 0 rgba(20,20,26,0.3); transition: transform .2s ease;
  }
  .vibes-close:hover{ transform: translateY(-2px); }

  /* ================= MODAL ================= */
  .modal-overlay{
    position:fixed; inset:0; z-index: 300; display:flex; align-items:center; justify-content:center;
    background: var(--overlay-bg); backdrop-filter: blur(6px); -webkit-backdrop-filter: blur(6px);
    opacity:0; pointer-events:none; transition: opacity .25s ease; padding: 24px;
  }
  .modal-overlay.open{ opacity:1; pointer-events:auto; }
  .modal-box{
    position:relative; width:100%; max-width: 520px; max-height: 84vh; overflow-y:auto;
    background: linear-gradient(165deg, var(--modal-from), var(--modal-to) 80%); border: 1px solid var(--line);
    border-radius: 26px; padding: 40px 36px; transform: translateY(14px) scale(0.98);
    transition: transform .25s ease;
  }
  .modal-overlay.open .modal-box{ transform: none; }
  .modal-close{
    position:absolute; top:20px; right:20px; width:34px; height:34px; border-radius:50%;
    border: 1px solid var(--line); background: var(--hover-bg); color: var(--ink);
    font-size:18px; line-height:1; cursor:pointer; display:flex; align-items:center; justify-content:center;
  }
  .modal-close:hover{ background: var(--hover-border); }
  .modal-period{ font-size: 12px; color: var(--ink-dim); background: var(--pill-bg); display:inline-block; padding: 5px 10px; border-radius: 20px; }
  .modal-box h3{ font-size: 26px; font-weight: 600; letter-spacing: -0.02em; margin-top: 16px; }
  .modal-box .modal-role{ font-size: 14.5px; color: var(--ink-dim); margin-top: 4px; }
  .modal-box ul{ margin-top: 22px; list-style:none; }
  .modal-box ul li{ position:relative; padding-left: 18px; font-size: 14.5px; color: var(--ink); line-height: 1.7; margin-bottom: 10px; }
  .modal-box ul li::before{ content:'–'; position:absolute; left:0; color: var(--ink-faint); }
  .video-modal-box{ max-width: 780px; }
  .video-modal-box h3{ margin-top: 0; }

  /* ================= RESPONSIVE / MOBILE ================= */
  @media (max-width: 900px){
    .screen{ height: 100vh; height: 100dvh; }

    nav{ padding: 0 16px; height: 64px; padding-left: max(16px, env(safe-area-inset-left)); padding-right: max(16px, env(safe-area-inset-right)); }
    :root{ --nav-h: 64px; }

    /* large blurred aurora backgrounds are expensive to paint — shrink them on mobile GPUs */
    #hero::before{ filter: blur(34px); }
    #contacts::before{ filter: blur(40px); }
    .logo{ font-size:17px; }
    .nav-links{ display:none; }
    .nav-burger{ display:flex; }

    #hero{ text-align:center; }
    #hero h1{ font-size: clamp(38px, 11vw, 56px); }
    .hero-quote{ max-width: 340px; margin-left:auto; margin-right:auto; }
    .hero-quote .hq-question{ font-size: 13px; }
    .hero-quote .hq-answer{ font-size: 14px; }

    .section-top{ flex-direction:column; padding: 0 18px; gap:12px; }
    .section-copy h2{ font-size: clamp(26px, 7.2vw, 36px); }
    .section-note{ text-align:left; max-width:100%; }

    #experience{ padding-top: calc(var(--nav-h) + 18px); }
    .stage{ margin-top: 18px; padding: 0 0 26px; justify-content:flex-start; }
    /* swap the fan layout for a swipeable, uniformly-sized card carousel */
    .cards{ display:flex; justify-content:flex-start; max-width:100%; width:100%;
      overflow-x:auto; overflow-y:visible; scroll-snap-type:x mandatory; -webkit-overflow-scrolling:touch;
      gap:14px; padding: 10px 18px 16px; }
    .cards::-webkit-scrollbar{ display:none; }
    .cards .card:not(:first-child){ margin-left:0; }
    .cards .card{ transform:none; scroll-snap-align:center; width: 76vw; max-width: 260px; }
    .cards .card:not(.selected):hover{ transform:none !important; }
    .cards .card.selected{ transform: translateY(-6px) !important; }

    #portfolio{ padding-top: calc(var(--nav-h) + 18px); }
    .carousel-wrap{ padding: 0 12px; gap: 6px; }
    .carousel-arrow{ display:none; }
    .flat-grid{ padding: 16px 12px 32px; gap: 12px; }
    .flat-card{ width: 76vw; max-width: 280px; min-height: 240px; padding:16px; }
    .flat-card h3{ font-size:15px; }
    .portfolio-more{ margin: 4px 18px 28px; font-size: 13px; }

    .about-wrap{ grid-template-columns: 1fr; padding: 32px 18px; gap: 24px; }
    .about-photo-grid{ max-width: 260px; margin: 0 auto; }
    .about-copy h2{ font-size: clamp(22px, 7vw, 30px); }
    .about-copy p{ font-size: 15px; }

    #contacts h2{ font-size: clamp(28px, 8vw, 40px); }
    .social-row{ gap: 10px; }
    .social-row a{ font-size: 13px; padding: 9px 16px; }

    .modal-box{ padding: 28px 22px; border-radius: 20px; }
    .modal-box h3{ font-size: 22px; }

    .secret-cue{ bottom: 14px; }
    .vibes-marquee.top{ top: 68px; }
    .vibes-marquee.bottom{ bottom: 18px; }
    .vibes-inner{ padding: 118px 18px 70px; }
    .vibes-close{ top: 16px; right: 16px; }
    .sticker{ font-size:12px; padding: 10px 14px; }

    .back-to-top{ right: 16px; bottom: 16px; width:44px; height:44px; }
    .back-to-top{ right: max(16px, env(safe-area-inset-right)); bottom: max(16px, env(safe-area-inset-bottom)); }
  }

  @media (max-width: 480px){
    .flat-card{ width: 82vw; }
    .cards .card{ width: 82vw; }
    .about-facts{ gap: 22px; }
    .social-row a{ font-size:13px; padding: 9px 16px; }
  }